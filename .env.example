BACKEND_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:3000
COGNEE_DATASET=private_memory
TELEMETRY_DISABLED=1
ENV=dev
COGNEE_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
DATA_ROOT_DIRECTORY=./backend/data/cognee
SYSTEM_ROOT_DIRECTORY=./backend/data/system
DB_PROVIDER=sqlite
DB_NAME=cognee_db
GRAPH_DATABASE_PROVIDER=kuzu
GRAPH_DATASET_DATABASE_HANDLER=kuzu
VECTOR_DB_PROVIDER=lancedb
VECTOR_DATASET_DATABASE_HANDLER=lancedb
ENABLE_BACKEND_ACCESS_CONTROL=True
CACHING=false
LLM_PROVIDER=ollama
